{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "declaration": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./src/.umi/*"],
      "@@test/*": ["./src/.umi-test/*"],
      "@root/*": ["./*"]
    }
  },
  "include": [
    "config/config.ts",
    "config/defaultSettings.ts",
    "src/app.tsx",
    "src/access.ts",
    "src/global.tsx",
    "src/loading.tsx",
    "src/typings.d.ts",
    "types/**/*.d.ts",
    "src/pages/Career/**/*.ts",
    "src/pages/Career/**/*.tsx",
    "src/pages/exception/404/**/*.tsx"
  ]
}
