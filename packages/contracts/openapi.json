  "info": {
    "title": "百年前程 AI成长课 API",
    "description": "首期本地系统；REST /api/v1；无登录匿名访客；MySQL持久化；外部服务local-simulated。所有时间UTC ISO8601；报表Asia/Shanghai。错误统一code/message/details/requestId。管理API仅回环+X-Admin-Local:1。",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "visitorBearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "服务端签发的64位十六进制访客凭据，无微信登录。"
      },
      "localAdmin": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Local",
        "description": "本地管理请求固定为1；不代表线上管理员鉴权。"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "mysql"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "test",
              "demo"
            ]
          },
          "externalServices": {
            "type": "string",
            "enum": [
              "local-simulated"
            ]
          }
        },
        "required": [
          "status",
          "database",
          "environment",
          "externalServices"
        ]
      },
      "VisitorSessionResponse": {
        "type": "object",
        "properties": {
          "visitorId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "test",
              "demo"
            ]
          },
          "storageNotice": {
            "type": "string",
            "example": "清除本机存储或换设备后，记录无法自动找回。"
          },
          "credential": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "仅返回一次，保存到本机；后续使用 Bearer 访问本人资源。"
          }
        },
        "required": [
          "visitorId",
          "createdAt",
          "environment",
          "storageNotice",
          "credential"
        ]
      },
      "VisitorResponse": {
        "type": "object",
        "properties": {
          "visitorId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "test",
              "demo"
            ]
          },
          "storageNotice": {
            "type": "string",
            "example": "清除本机存储或换设备后，记录无法自动找回。"
          }
        },
        "required": [
          "visitorId",
          "createdAt",
          "environment",
          "storageNotice"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requestId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "description": "有效客户端关联ID原样返回；无效或缺失时服务端生成UUID。"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId"
        ]
      }
    }
  }
}
